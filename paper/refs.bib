@article{vaughan1984,
  author  = {Vaughan, R. J.},
  title   = {Approximate Formulas for Average Distances Associated with Zones},
  journal = {Transportation Science},
  volume  = {18},
  number  = {3},
  pages   = {231--244},
  year    = {1984},
  doi     = {10.1287/trsc.18.3.231},
  note    = {[T] LISTED AS A CORRECTION, NOT AS SUPPORT. This DOI was cited
             in src/siting_atlas/cost/params.py and docs/REFERENCES.md as
             "Daganzo (1984), Approximate formulas ..., 18(3), 231-253" and
             described as a companion paper and the source of the
             zone-geometry constant. It is by Vaughan, spans pp. 231-244,
             and concerns average distances between random points in zones:
             no tour, no vehicle, no capacity, no tour-length constant.
             Resolved against api.openalex.org twice independently
             2026-09-14. It supports nothing in the cost model.}
}

