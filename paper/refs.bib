  journal = {Transportation Science},
  volume  = {18},
  number  = {4},
  pages   = {331--350},
  year    = {1984},
  doi     = {10.1287/trsc.18.4.331},
  note    = {[T] NOT READ. No copy could be obtained on the host where this
             project was built; the DOI resolves to a publisher page behind a
             challenge. What was retrieved and read is the abstract, via
             api.openalex.org on 2026-09-14. Cited ONLY for the structural
             decomposition the code implements (line haul shared across a
             tour of C stops, plus local travel in k/sqrt(density)). It is
             NOT cited for the numeric constant, and no page number,
             section number or quotation from it appears anywhere in this
             project. The abstract also states that zone SHAPE is the
             paper's contribution, which our implementation does not
             represent at all.}
}

