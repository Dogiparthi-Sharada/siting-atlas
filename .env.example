# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# All three are FREE and issued instantly. None is needed to reproduce the
# published results -- `make reproduce` runs offline. They are required only
# for Path B in the README, rebuilding the derived tables from raw sources.

# US Census Bureau -- ACS, County Business Patterns, Building Permits, TIGER
#   https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# US Energy Information Administration -- fuel prices for the cost model
#   https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# US Department of Labor -- OSHA enforcement bulk data
#   https://dataportal.dol.gov/registration
# Optional: the OSHA archive can also be downloaded from the browser without
# a key. See docs/DATA_SOURCES.md.
DOL_GOV_API_KEY=
